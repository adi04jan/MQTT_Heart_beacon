HB_CFG_KEY=/etc/hb/cfg-sign.key
HB_TLS_CERT=/etc/hb/leaf.crt
HB_TLS_KEY=/etc/hb/leaf.key
HB_MQTT_PORT=8883
HB_API_PORT=8443
HB_ADMIN_PORT=8444
HB_MQTT_LOCAL_PORT=1884
